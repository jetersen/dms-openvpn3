{
  "$schema": "https://duxlabs.dev/schemas/plugin.json",
  "id": "openvpn3",
  "name": "Dux Shell Integration for OpenVPN® 3",
  "description": "Independent Dux Shell integration for OpenVPN® 3 Linux profiles and sessions",
  "version": "0.2.0",
  "author": "Joseph",
  "type": "widget",
  "capabilities": ["vpn", "network", "dankbar-widget"],
  "component": "./OpenVpn3Widget.qml",
  "startupCheck": "./StartupCheck.qml",
  "icon": "vpn_lock",
  "screenshot": "https://raw.githubusercontent.com/jetersen/dms-openvpn3/main/docs/screenshot.png",
  "requires_dms": ">=2.0.0",
  "dependencies": ["openvpn3", "python3", "python3-dbus"],
  "permissions": ["process"]
}
